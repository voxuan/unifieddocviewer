# Unified Document Viewer Environment & Port Configuration
# Copy this file to .env to override default ports in case of local port conflicts.

# Unified Document Viewer Application Port (Default: 8080, fallback: 8085)
APP_PORT=8080
PORT=8080

# PostgreSQL Port (Default: 5432)
DB_PORT=5432
DB_HOST=localhost
DB_NAME=docviewer
DB_USER=docuser
DB_PASS=docpassword

# WireMock Stubs Ports
SALES_PORT=8081
SERVICE_PORT=8082
IDP_PORT=8088
